# Run `node infra/generate-local-env.mjs` to create a private, gitignored `.env`.
# Secret fields are intentionally empty; never commit generated values.
APP_ENV=local
POSTGRES_DB=huoqiu_local
POSTGRES_USER=huoqiu_local
POSTGRES_PASSWORD=
DATABASE_URL=
VALKEY_PASSWORD=
VALKEY_URL=
BETTER_AUTH_SECRET=
ALPHA_INVITE_CODES=
ZERO_TRUST_HMAC_SECRET=
ZERO_TRUST_ISSUER=http://127.0.0.1:8787
ZERO_TRUST_MAX_SKEW_SECONDS=300
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=huoqiu-api
HTTP_HOST=127.0.0.1
PORT=3000
