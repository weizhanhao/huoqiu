{
  "name": "@huoqiu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-contract-runtime.mjs && node test/verify-built-entrypoints.mjs",
    "dev": "tsx watch src/main.ts",
    "dev:worker:events": "tsx watch src/workers/events.main.ts",
    "dev:worker:market": "tsx watch src/workers/market.main.ts",
    "lint": "eslint --config ../../packages/config/eslint/base.mjs scripts src test vitest.config.ts",
    "start": "node dist/main.js",
    "start:worker:events": "node dist/workers/events.main.js",
    "start:worker:market": "node dist/workers/market.main.js",
    "test": "vitest run --config vitest.config.ts test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@huoqiu/contracts": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "1.6.26",
    "fastify": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@huoqiu/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "tsx": "4.23.9",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
