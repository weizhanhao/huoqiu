  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "expo export --platform web",
    "dev": "expo start",
    "lint": "eslint --config ../../packages/config/eslint/react.mjs app src tests vitest.config.ts",
    "test": "vitest run --config vitest.config.ts tests",
