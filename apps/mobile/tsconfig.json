{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "expo/tsconfig.base",
    "@huoqiu/config/tsconfig/react-native"
  ],
  "compilerOptions": {
    "strict": true,
    "types": [
      "react",
      "react-native"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts"
  ]
}
