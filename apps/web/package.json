{
  "name": "@huoqiu/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint --config ../../packages/config/eslint/react.mjs src scripts tests next.config.ts vitest.config.ts",
    "start": "node scripts/start.mjs",
    "test": "vitest run --config vitest.config.ts tests src/middleware.spec.ts src/start.spec.ts",
    "test:d0": "vitest run --config vitest.config.ts tests/component/d0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huoqiu/contracts": "workspace:*",
    "@huoqiu/web-ui": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@huoqiu/config": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
