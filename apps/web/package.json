{
  "name": "@huoqiu/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "build:release": "node scripts/build-release.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "finance:fx": "node scripts/fetch-fx-rates.mjs",
    "finance:kline": "node scripts/fetch-kline.mjs",
    "finance:news": "../../node_modules/.bin/tsx scripts/fetch-finance-public.ts",
    "lint": "eslint --config ../../packages/config/eslint/react.mjs src scripts tests next.config.ts vitest.config.ts",
    "start": "node scripts/start.mjs",
    "test": "vitest run --config vitest.config.ts tests src/middleware.spec.ts src/start.spec.ts",
    "test:d0": "vitest run --config vitest.config.ts tests/component/d0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huoqiu/contracts": "workspace:*",
    "@huoqiu/web-ui": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@huoqiu/domain": "workspace:*"
  },
  "devDependencies": {
    "@huoqiu/config": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
