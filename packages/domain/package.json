{
  "name": "@huoqiu/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./shared/decimal": "./src/shared/decimal.ts",
    "./shared/ids": "./src/shared/ids.ts",
    "./shared/time": "./src/shared/time.ts",
    "./market/portfolio-return": "./src/market/portfolio-return.ts",
    "./social/comment-tree": "./src/social/comment-tree.ts",
    "./social/post-body": "./src/social/post-body.ts",
    "./social/post-channel": "./src/social/post-channel.ts"
  },
  "scripts": {
    "lint": "eslint --config ../config/eslint/base.mjs src test",
    "test": "vitest run --config ../config/vitest/base.ts test",
    "typecheck": "tsc --noEmit --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --useUnknownInCatchVariables --verbatimModuleSyntax --module NodeNext --moduleResolution NodeNext --target ES2023 --types node,vitest/globals src/shared/decimal.ts src/shared/ids.ts src/shared/time.ts test/shared/decimal.spec.ts"
  },
  "devDependencies": {
    "@huoqiu/config": "workspace:*"
  },
  "peerDependencies": {
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
