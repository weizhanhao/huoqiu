{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huoqiu.invalid/schemas/trust-registry.v2.json",
  "title": "Huoqiu root-signed trust registry v2",
  "type": "object",
  "additionalProperties": false,
  "$comment": "Runtime verification additionally validates root SPKI/key-ID pins from a protected channel, the detached root signature, verifier, repository and accepted-epoch pins, policy/repository consistency, key-ID derivation, epoch linkage, and expiry.",
  "required": [
    "schema_version",
    "trust_domain",
    "repository_id",
    "epoch",
    "previous_registry_sha256",
    "expires_at",
    "verifier_sha256",
    "keys",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "trust_domain": { "const": "huoqiu-quality" },
    "repository_id": { "$ref": "#/$defs/positiveDecimal" },
    "epoch": { "type": "integer", "minimum": 1 },
    "previous_registry_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "verifier_sha256": { "$ref": "#/$defs/sha256" },
    "keys": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/keyId" },
      "additionalProperties": { "$ref": "#/$defs/policy" }
    },
    "signature": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/signature" }]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "keyId": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "positiveDecimal": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value_base64"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/keyId" },
        "value_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "roles",
        "actor",
        "actor_id",
        "repository",
        "repository_id",
        "workflow_ref",
        "workflow_sha",
        "ref",
        "event_name",
        "protected_environment",
        "public_key_spki_pem"
      ],
      "properties": {
        "subject_id": { "type": "string", "pattern": "^github:[1-9][0-9]*$" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["review", "authorship"] }
        },
        "actor": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "actor_id": { "$ref": "#/$defs/positiveDecimal" },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "repository_id": { "$ref": "#/$defs/positiveDecimal" },
        "workflow_ref": {
          "type": "string",
          "pattern": "^[^\\u0000\\r\\n]+/\\.github/workflows/[^\\u0000\\r\\n]+@refs/[^\\u0000\\r\\n]+$"
        },
        "workflow_sha": { "$ref": "#/$defs/gitSha40" },
        "ref": {
          "type": "string",
          "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$"
        },
        "event_name": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "protected_environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "public_key_spki_pem": { "type": "string", "minLength": 1 }
      }
    }
  }
}
